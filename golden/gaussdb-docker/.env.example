# SpinDuck 黄金对比容器的口令注入（复制为 .env 后改成你自己的口令）：
#   cp .env.example .env && $EDITOR .env
# .env 已被仓库 .gitignore 忽略，绝不入库。
# openGauss initdb 的复杂度校验要求四类字符齐全（大写 + 小写 + 数字 + 特殊字符）且
# 长度 ≥8，否则容器在引导阶段反复报 "The supplied GS_PASSWORD is not meet
# requirements" 直到 healthcheck 超时。下面的占位值本身满足校验，可直接首启。
GS_PASSWORD=Change@me1
